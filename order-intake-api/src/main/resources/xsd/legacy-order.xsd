<?xml version="1.0" encoding="UTF-8"?>
<!--
  Legacy OMS order contract (what TIBCO BusinessWorks / the store POS sends today).
  Namespace: http://tailoredbrands.com/legacy/oms/v1
  JAXB classes are generated by jaxb2-maven-plugin (xjc) into
  com.tailoredbrands.otd.orderintake.legacy.xml and the same XSD backs the WSDL at /ws/orders.wsdl.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://tailoredbrands.com/legacy/oms/v1"
           targetNamespace="http://tailoredbrands.com/legacy/oms/v1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ===== SOAP operation payloads ===== -->

  <xs:element name="SubmitOrderRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Order" type="tns:LegacyOrder"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="SubmitOrderResponse">
    <xs:complexType>
      <xs:sequence>
        <!-- legacy order number echoed back -->
        <xs:element name="OrderNbr" type="xs:string"/>
        <!-- canonical id ORD-yyyy-nnnnnn (empty when rejected) -->
        <xs:element name="OrderId" type="xs:string" minOccurs="0"/>
        <!-- ACCEPTED | REJECTED -->
        <xs:element name="Status" type="xs:string"/>
        <xs:element name="Message" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ===== Legacy order model =====
       <Order><OrderNbr/><OrderType/><StoreNbr/><CustNbr/><OrderDate/>
              <Lines><Line><LineNbr/><SKU/><Qty/><Price/><FulfillType/><Alteration>...</Alteration></Line></Lines>
       </Order> -->

  <xs:complexType name="LegacyOrder">
    <xs:sequence>
      <xs:element name="OrderNbr" type="xs:string"/>
      <!-- R=RETAIL T=TAILORED C=CUSTOM X=RENTAL E=ECOM -->
      <xs:element name="OrderType" type="tns:LegacyOrderTypeCode"/>
      <xs:element name="StoreNbr" type="tns:StoreNbr"/>
      <xs:element name="CustNbr" type="xs:string" minOccurs="0"/>
      <!-- ISO-8601 date-time, e.g. 2026-10-03T22:14:00Z -->
      <xs:element name="OrderDate" type="xs:dateTime"/>
      <xs:element name="PromiseDate" type="xs:date" minOccurs="0"/>
      <xs:element name="Currency" type="xs:string" minOccurs="0"/>
      <xs:element name="Lines" type="tns:LegacyLines"/>
      <xs:element name="Rental" type="tns:LegacyRental" minOccurs="0"/>
      <xs:element name="ShipTo" type="tns:LegacyAddress" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LegacyLines">
    <xs:sequence>
      <xs:element name="Line" type="tns:LegacyOrderLine" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LegacyOrderLine">
    <xs:sequence>
      <xs:element name="LineNbr" type="xs:int"/>
      <xs:element name="SKU" type="xs:string"/>
      <xs:element name="Qty" type="xs:int"/>
      <xs:element name="Price" type="xs:decimal"/>
      <!-- P=STORE_PICKUP S=SHIP_TO_HOME A=ALTERATION -->
      <xs:element name="FulfillType" type="tns:LegacyFulfillTypeCode"/>
      <xs:element name="Alteration" type="tns:LegacyAlteration" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LegacyAlteration">
    <xs:sequence>
      <xs:element name="AltType" type="xs:string"/>
      <xs:element name="Measurement" type="xs:decimal" minOccurs="0"/>
      <xs:element name="TailorShop" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LegacyRental">
    <xs:sequence>
      <xs:element name="EventNbr" type="xs:string" minOccurs="0"/>
      <xs:element name="EventDate" type="xs:date" minOccurs="0"/>
      <xs:element name="ReturnDate" type="xs:date" minOccurs="0"/>
      <xs:element name="GroupNbr" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LegacyAddress">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="0"/>
      <xs:element name="Addr1" type="xs:string"/>
      <xs:element name="Addr2" type="xs:string" minOccurs="0"/>
      <xs:element name="City" type="xs:string"/>
      <xs:element name="State" type="xs:string"/>
      <xs:element name="Zip" type="xs:string"/>
      <xs:element name="Country" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="StoreNbr">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LegacyOrderTypeCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[RTCXE]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LegacyFulfillTypeCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[PSA]"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
